<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../src/ForceDeleter/*.cs" Exclude="../src/ForceDeleter/Program.cs" />
    <EmbeddedResource Include="../src/ForceDeleter/Assets/Icons/*.svg" Link="Assets/Icons/%(Filename)%(Extension)" LogicalName="ForceDeleter.Assets.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
